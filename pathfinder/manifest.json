{
  "manifest_version": 3,
  "name": "Pathfinder (dev)",
  "version": "0.4.0",
  "description": "Job search copilot for international students: sponsorship verdict with H-1B history, resume score and AI edits, and local people most likely to respond.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["sidePanel", "scripting", "storage", "unlimitedStorage", "activeTab"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://*.indeed.com/*",
    "https://jobright.ai/*",
    "https://*.jobright.ai/*",
    "https://www.google.com/*",
    "https://*.glassdoor.com/*",
    "https://*.greenhouse.io/*",
    "https://*.lever.co/*",
    "https://*.myworkdayjobs.com/*",
    "https://*.myworkdaysite.com/*",
    "https://*.ashbyhq.com/*",
    "https://*.smartrecruiters.com/*",
    "https://*.icims.com/*",
    "https://*.ziprecruiter.com/*",
    "https://*.dice.com/*",
    "https://wellfound.com/*",
    "https://*.joinhandshake.com/*",
    "https://api.anthropic.com/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": {
    "default_title": "Open Pathfinder",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  }
}
